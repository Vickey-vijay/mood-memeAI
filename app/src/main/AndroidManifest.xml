<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- SPEC_V3 C.4 - floating overlay bubble -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodBoard">

        <!-- The keyboard (Input Method Editor) service -->
        <service
            android:name=".ime.MoodBoardService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Onboarding / enable-keyboard / API-key entry screen -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sticker manager: level-1 mood grid (SPEC_V2 B.3) -->
        <activity
            android:name=".ui.StickerManagerActivity"
            android:exported="false"
            android:label="@string/manage_stickers" />

        <!-- Sticker manager: level-2 grid of one mood's stickers (SPEC_V2 B.3) -->
        <activity
            android:name=".ui.MoodStickersActivity"
            android:exported="false" />

        <!-- Share target: "Share -> MoodBoard" from WhatsApp or any app (SPEC_V2 B.4 route 1) -->
        <activity
            android:name=".ui.ReceiveStickerActivity"
            android:exported="true"
            android:label="@string/receive_sticker_title"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Emotion Engine v2: neutral-face calibration (SPEC_V2 A.2 / A.8) -->
        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false"
            android:label="@string/calibration_title" />

        <!-- Emotion Engine v2: live AU/distribution debug view for report screenshots -->
        <activity
            android:name=".ui.EmotionLabActivity"
            android:exported="false"
            android:label="@string/emotion_lab_title" />

        <!-- Transparent activity used by the IME to request the CAMERA permission -->
        <activity
            android:name=".camera.PermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true" />

        <!-- SPEC_V3 C.4 - floating bubble foreground service.
             specialUse is the correct type: this service exists solely to keep a
             SYSTEM_ALERT_WINDOW bubble on screen, which matches no predefined FGS type.
             It is never started from the background - only from OverlayPermissionActivity,
             i.e. a user tap in a visible Activity - so the Android 12+ background-FGS-start
             restriction is satisfied, and START_NOT_STICKY keeps the system from restarting
             it on its own.
             NOTE for the Android 14+ reviewer: the panel opens the front camera while
             scanning. The process has a visible overlay window at that moment, which is what
             keeps it out of the "background camera access" ban. If a specific OEM build on
             Android 16 still denies camera frames to this service, the one-line fix is to
             declare foregroundServiceType="specialUse|camera" here and add
             <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
             above. Kept spec-exact (specialUse only) as SPEC_V3 C.4 mandates. -->
        <service
            android:name=".overlay.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="floating_meme_launcher" />
        </service>

        <!-- Transparent gatekeeper: POST_NOTIFICATIONS (API 33+) then SYSTEM_ALERT_WINDOW,
             then it starts the service. The only legal entry point to the bubble. -->
        <activity
            android:name=".ui.OverlayPermissionActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true" />

        <!-- Grants temporary read access to cached GIF/sticker files for the target chat app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
