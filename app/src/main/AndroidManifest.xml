<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoodBoard">

        <!-- The keyboard (Input Method Editor) service -->
        <service
            android:name=".ime.MoodBoardService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Onboarding / enable-keyboard / API-key entry screen -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sticker manager: level-1 mood grid (SPEC_V2 B.3) -->
        <activity
            android:name=".ui.StickerManagerActivity"
            android:exported="false"
            android:label="@string/manage_stickers" />

        <!-- Sticker manager: level-2 grid of one mood's stickers (SPEC_V2 B.3) -->
        <activity
            android:name=".ui.MoodStickersActivity"
            android:exported="false" />

        <!-- Share target: "Share -> MoodBoard" from WhatsApp or any app (SPEC_V2 B.4 route 1) -->
        <activity
            android:name=".ui.ReceiveStickerActivity"
            android:exported="true"
            android:label="@string/receive_sticker_title"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Emotion Engine v2: neutral-face calibration (SPEC_V2 A.2 / A.8) -->
        <activity
            android:name=".ui.CalibrationActivity"
            android:exported="false"
            android:label="@string/calibration_title" />

        <!-- Emotion Engine v2: live AU/distribution debug view for report screenshots -->
        <activity
            android:name=".ui.EmotionLabActivity"
            android:exported="false"
            android:label="@string/emotion_lab_title" />

        <!-- Transparent activity used by the IME to request the CAMERA permission -->
        <activity
            android:name=".camera.PermissionActivity"
            android:exported="false"
            android:theme="@style/Theme.Transparent"
            android:excludeFromRecents="true" />

        <!-- Grants temporary read access to cached GIF/sticker files for the target chat app -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
