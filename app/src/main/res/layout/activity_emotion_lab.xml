<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/emotion_lab_title"
        android:textColor="@color/kb_text"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/emotionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:text="@string/lab_uncalibrated" />

    <TextView
        android:id="@+id/distributionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/intensityText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/calibrationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/md_success"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <View style="@style/SetupDivider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp"
        android:letterSpacing="0.06"
        android:textAllCaps="true"
        android:text="@string/lab_au_header"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/auList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceLabelSmall" />

</LinearLayout>
