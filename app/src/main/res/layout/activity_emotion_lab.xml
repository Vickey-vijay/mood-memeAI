<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/emotion_lab_title"
        android:textColor="@color/kb_text"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <androidx.camera.view.PreviewView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="180dp" />

    <TextView
        android:id="@+id/emotionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:text="@string/lab_uncalibrated" />

    <TextView
        android:id="@+id/distributionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/intensityText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <TextView
        android:id="@+id/calibrationText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/md_success"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/lab_au_header"
        android:textColor="@color/kb_text"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/auList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceLabelSmall" />

</LinearLayout>
