<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:textColor="@color/kb_text"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:lineSpacingMultiplier="1.0" />

        <!-- Hero card: the one thing this screen needs you to do. Bigger radius, saffron
             outline, most padding - deliberately the loudest surface here. -->
        <LinearLayout style="@style/SetupCardHero">
            <LinearLayout style="@style/SetupCardHeaderRow">
                <ImageView
                    style="@style/SetupCardIcon"
                    android:src="@drawable/ic_keyboard"
                    android:contentDescription="@null" />
                <TextView style="@style/SetupCardTitle" android:text="@string/step1" />
            </LinearLayout>
            <Button
                android:id="@+id/btnEnable"
                style="@style/SetupButton"
                android:layout_marginTop="12dp"
                app:icon="@drawable/ic_settings"
                android:text="@string/btn_enable" />

            <Button
                android:id="@+id/btnSwitch"
                style="@style/SetupButtonSecondary"
                app:icon="@drawable/ic_keyboard"
                android:text="@string/btn_switch" />
        </LinearLayout>

        <!-- Library section - a header + a single quiet action, not a redundant card. -->
        <TextView style="@style/SetupSectionHeader" android:text="@string/section_library" />
        <View style="@style/SetupDivider" />

        <Button
            android:id="@+id/btnManageStickers"
            style="@style/SetupButtonSecondary"
            android:layout_marginTop="12dp"
            app:icon="@drawable/ic_stickers"
            android:text="@string/btn_manage_stickers" />

        <!-- Accuracy section - calibration + the diagnostic lab live together, grouped by
             typography instead of a box. -->
        <TextView style="@style/SetupSectionHeader" android:text="@string/section_accuracy" />
        <View style="@style/SetupDivider" />

        <TextView
            android:id="@+id/calibrationStateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/calibration_state_uncalibrated"
            android:textColor="@color/kb_text_muted"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/btnCalibrate"
            style="@style/SetupButtonSecondary"
            app:icon="@drawable/ic_calibrate"
            android:text="@string/btn_calibrate" />

        <Button
            android:id="@+id/btnEmotionLab"
            style="@style/SetupButtonSecondary"
            app:icon="@drawable/ic_lab"
            android:text="@string/btn_emotion_lab" />

        <!-- Advanced - meme sources, pre-caching and the floating button are configuration,
             not everyday controls, so they start collapsed instead of piling up as more
             identical cards. -->
        <LinearLayout
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/section_advanced"
                android:textAllCaps="true"
                android:textColor="@color/kb_text_muted"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textStyle="bold" />
            <ImageView
                android:id="@+id/advancedChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
        <View style="@style/SetupDivider" />

        <LinearLayout
            android:id="@+id/advancedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Meme sources -->
            <LinearLayout style="@style/SetupCardHeaderRow" android:layout_marginTop="18dp">
                <ImageView
                    style="@style/SetupCardIcon"
                    android:src="@drawable/ic_stickers"
                    android:contentDescription="@null" />
                <TextView style="@style/SetupCardTitle" android:text="@string/meme_sources_card_title" />
            </LinearLayout>

            <TextView style="@style/SetupCardBody" android:text="@string/meme_sources_card_explain" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/meme_category_label"
                android:textColor="@color/kb_text"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <Spinner
                android:id="@+id/spinnerMemeCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/tile_bg"
                android:padding="12dp"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/inputMemeCategoryCustom"
                style="@style/SetupInput"
                android:layout_marginTop="8dp"
                android:hint="@string/hint_meme_category_custom"
                android:inputType="text"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_label_giphy_gifs"
                    android:textColor="@color/kb_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <Switch
                    android:id="@+id/switchSourceGiphyGifs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_label_giphy_stickers"
                    android:textColor="@color/kb_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <Switch
                    android:id="@+id/switchSourceGiphyStickers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_label_giphy_trending"
                    android:textColor="@color/kb_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <Switch
                    android:id="@+id/switchSourceGiphyTrending"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_label_imgflip"
                    android:textColor="@color/kb_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <Switch
                    android:id="@+id/switchSourceImgflip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/source_label_tenor"
                    android:textColor="@color/kb_text"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                <Switch
                    android:id="@+id/switchSourceTenor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputTenorKey"
                style="@style/SetupInput"
                android:layout_marginTop="12dp"
                android:hint="@string/hint_tenor_key"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:singleLine="true"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnSaveTenorKey"
                style="@style/SetupButtonSecondary"
                app:icon="@drawable/ic_check"
                android:text="@string/btn_save_tenor_key" />

            <View style="@style/SetupDivider" android:layout_marginTop="18dp" />

            <!-- Floating meme button -->
            <LinearLayout style="@style/SetupCardHeaderRow" android:layout_marginTop="18dp">
                <ImageView
                    style="@style/SetupCardIcon"
                    android:src="@drawable/ic_bubble"
                    android:contentDescription="@null" />
                <TextView style="@style/SetupCardTitle" android:text="@string/overlay_card_title" />
            </LinearLayout>

            <TextView
                style="@style/SetupCardBody"
                android:text="@string/overlay_card_explain" />

            <TextView
                android:id="@+id/overlayStateText"
                style="@style/SetupCardBody"
                android:layout_marginTop="10dp"
                android:textColor="@color/kb_text"
                android:text="@string/overlay_state_stopped" />

            <Button
                android:id="@+id/btnOverlayStart"
                style="@style/SetupButtonSecondary"
                app:icon="@drawable/ic_bubble"
                android:text="@string/btn_overlay_start" />

            <Button
                android:id="@+id/btnOverlayStop"
                style="@style/SetupButtonDestructive"
                app:icon="@drawable/ic_close"
                android:text="@string/btn_overlay_stop" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
