<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kb_toolbar"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="@color/kb_text" />

        <ImageButton
            android:id="@+id/btnBackToKeys"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_abc"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/kb_text" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/kb_text"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/setup_intro" />

        <Button
            android:id="@+id/btnMood"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="@drawable/mood_btn_bg"
            android:textColor="@color/white"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:contentDescription="@string/cd_mood"
            android:text="🙂 Mood" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.moodboard.keyboard.ime.QwertyKeyboardView
            android:id="@+id/qwerty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stickerGrid"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:padding="4dp" />

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/cameraHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="10dp"
                android:background="#99000000"
                android:padding="8dp"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:text="@string/scanning" />
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
