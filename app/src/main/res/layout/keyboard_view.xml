<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kb_background"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kb_toolbar"
        android:paddingStart="6dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_settings"
            app:tint="?attr/colorControlNormal" />

        <ImageButton
            android:id="@+id/btnBackToKeys"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:visibility="gone"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_abc"
            android:src="@drawable/ic_keyboard"
            app:tint="?attr/colorControlNormal" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@color/kb_text_muted"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/kb_status_idle" />

        <!-- The mood button is the hero affordance of the keyboard: full-round saffron pill,
             clearly bigger than every neighbouring control. -->
        <Button
            android:id="@+id/btnMood"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            style="@style/KbButtonPrimary"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_mood"
            android:drawablePadding="6dp"
            android:contentDescription="@string/cd_mood"
            android:text="@string/btn_mood_label" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.moodboard.keyboard.ime.QwertyKeyboardView
            android:id="@+id/qwerty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/stickerGrid"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:padding="4dp" />

        <FrameLayout
            android:id="@+id/cameraContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg"
            android:clipToOutline="true"
            android:visibility="gone">

            <androidx.camera.view.PreviewView
                android:id="@+id/cameraPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/calibrationNudge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="8dp"
                android:background="@drawable/chip_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:textColor="@color/kb_text"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:gravity="center"
                android:visibility="gone"
                android:text="@string/calibrate_nudge" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="#B3000000"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/cameraHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:textColor="@color/white"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:text="@string/scanning" />

                <!-- The "why" contributors read as a small designed tag, not a debug string. -->
                <TextView
                    android:id="@+id/cameraWhyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/chip_pill_bg"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/kb_text_muted"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </FrameLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- SPEC_V3 A.7: GIPHY/Tenor attribution, shown only when online results are present. -->
        <TextView
            android:id="@+id/attributionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/chip_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/kb_text_muted"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
