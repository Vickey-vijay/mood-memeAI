<?xml version="1.0" encoding="utf-8"?>
<!--
  SPEC_V3 C.3: the expanded overlay panel. MATCH_PARENT wide, ~60% tall, bottom gravity —
  the height and gravity are applied by FloatingBubbleService in the WindowManager params,
  so the root here is just match_parent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayPanelRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/overlay_look_at_camera"
            android:textColor="@color/kb_text"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <Button
            android:id="@+id/btnOverlayRescan"
            style="@style/SetupButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:drawableStart="@drawable/ic_refresh"
            android:drawablePadding="4dp"
            android:text="@string/overlay_btn_rescan"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOverlayClose"
            style="@style/SetupButtonSecondary"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="0dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:drawableStart="@drawable/ic_close"
            android:drawablePadding="4dp"
            android:text="@string/overlay_btn_close"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlayCameraContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:clipToOutline="true">

        <androidx.camera.view.PreviewView
            android:id="@+id/overlayCameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/overlayCameraHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="@string/overlay_starting_camera"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/overlayWhyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/chip_pill_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:textColor="@color/kb_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/overlayStickerGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/overlayProgress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- SPEC_V3 A.7 attribution; only visible when online results contributed. -->
        <TextView
            android:id="@+id/overlayAttribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/chip_pill_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textColor="@color/kb_text_muted"
            android:textSize="9sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/overlayHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/overlay_tap_to_copy"
        android:textColor="@color/kb_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- The one hero action of the panel: confirm the detected mood. -->
        <Button
            android:id="@+id/btnOverlayUseMood"
            style="@style/SetupButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_weight="1.3"
            android:drawableStart="@drawable/ic_check"
            android:text="@string/overlay_btn_use_mood"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnOverlayShare"
            style="@style/SetupButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_share"
            android:text="@string/overlay_btn_share"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
