<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kb_background">

    <!-- Wraps both header rows so layout_below="@id/header" anchors below whichever one
         is visible (see MoodStickersActivity#updateSelectionChrome). -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/normalHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/moodTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/kb_text"
                android:textAppearance="?attr/textAppearanceTitleLarge" />

            <Button
                android:id="@+id/btnSelectMode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kb_accent"
                android:textAllCaps="false"
                android:text="@string/btn_select" />

            <Button
                android:id="@+id/btnImportFolder"
                style="@style/SetupButtonSecondary"
                android:layout_width="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginStart="4dp"
                app:icon="@drawable/ic_folder"
                android:text="@string/btn_import_folder_short" />
        </LinearLayout>

        <!-- Multi-select mode header (client bug fix): swapped in for normalHeaderRow via
             visibility toggles, never both visible at once. -->
        <LinearLayout
            android:id="@+id/selectionHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/selectionCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/kb_text"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <Button
                android:id="@+id/btnSelectAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kb_accent"
                android:textAllCaps="false"
                android:text="@string/btn_select_all" />

            <Button
                android:id="@+id/btnClearSelection"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/kb_accent"
                android:textAllCaps="false"
                android:text="@string/btn_clear_selection" />
        </LinearLayout>
    </LinearLayout>

    <!-- Outcome 6: move/favourite/delete are long-press only, so hint at them in a
         header that is visible whether or not the grid is empty. -->
    <TextView
        android:id="@+id/moodHintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/header"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/mood_stickers_hint"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodySmall" />

    <View
        style="@style/SetupDivider"
        android:layout_below="@id/moodHintText"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <TextView
        android:id="@+id/emptyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/moodHintText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="@string/mood_empty_state"
        android:textColor="@color/kb_text_muted"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:lineSpacingMultiplier="1.2" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/stickerGrid"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/moodHintText"
        android:layout_above="@id/selectionActionBar"
        android:clipToPadding="false"
        android:padding="10dp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:contentDescription="@string/add_sticker"
        app:backgroundTint="@color/kb_accent"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/md_on_primary" />

    <!-- Multi-select bulk actions (client bug fix: move/delete many mis-filed stickers at
         once). Replaces the FAB while selection mode is active; layout_above on
         stickerGrid collapses to zero when this is gone, so the grid fills the screen
         normally otherwise. -->
    <LinearLayout
        android:id="@+id/selectionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@color/kb_toolbar"
        android:padding="12dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnMoveSelected"
            style="@style/SetupButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="6dp"
            app:icon="@drawable/ic_move"
            android:text="@string/sticker_action_move" />

        <Button
            android:id="@+id/btnDeleteSelected"
            style="@style/SetupButtonDestructive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="0dp"
            android:layout_marginStart="6dp"
            app:icon="@drawable/ic_delete"
            android:text="@string/sticker_action_delete" />
    </LinearLayout>
</RelativeLayout>
