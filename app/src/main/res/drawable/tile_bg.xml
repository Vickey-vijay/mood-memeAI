<!-- Small repeated tiles (sticker/emoji grid cells, text inputs) - 8dp radius, same scale
     as keyboard keys since these are dense, small, repeated surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/md_surface_variant"/>
    <corners android:radius="8dp"/>
</shape>
