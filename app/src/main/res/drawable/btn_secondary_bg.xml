<!-- Quiet tonal button for secondary actions - deliberately less loud than mood_btn_bg so
     a screen's one real hero action still reads as the hero. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_variant"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/md_outline"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_surface_container_high"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="@color/md_outline_variant"/>
        </shape>
    </item>
</selector>
