<resources>
    <style name="SetupStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <!-- Primary / hero action: the one dominant CTA on a screen. Saffron fill, full pill,
         generous height - this should visually outrank every other control around it. -->
    <style name="SetupButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/mood_btn_bg</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawableTint">@color/md_on_primary</item>
        <item name="android:drawablePadding">10dp</item>
    </style>

    <!-- Secondary action: quiet tonal button. Same family as SetupButton but visually demoted
         so it never competes with the real hero action on the same screen. -->
    <style name="SetupButtonSecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_secondary_bg</item>
        <item name="android:textColor">@color/kb_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawableTint">@color/kb_accent</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <!-- Destructive / stop action: coral outline, used sparingly. -->
    <style name="SetupButtonDestructive">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/btn_destructive_outline_bg</item>
        <item name="android:textColor">@color/md_error</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawableTint">@color/md_error</item>
        <item name="android:drawablePadding">8dp</item>
    </style>

    <style name="SetupInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/tile_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textColorHint">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <!-- Standard card: quiet neutral container, 12dp radius. Used for ordinary grouped
         controls - never the loudest thing on the screen. -->
    <style name="SetupCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Hero card: the single dominant surface on a screen (e.g. "enable the keyboard").
         Bigger radius, a saffron outline, more breathing room - deliberately different from
         every other card so the eye lands here first. -->
    <style name="SetupCardHero" parent="SetupCard">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/card_hero_bg</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="SetupCardHeaderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="SetupCardIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>
    <style name="SetupCardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>
    <style name="SetupCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Small-caps section label used instead of another card box: groups related controls
         with typography and a divider rather than another identical rounded rectangle. -->
    <style name="SetupSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SetupDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/md_outline_variant</item>
    </style>
</resources>
