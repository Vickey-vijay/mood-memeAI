<resources>
    <style name="SetupStep">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>

    <!--
      These three MUST inherit from Widget.Material3.Button.*.

      Under Theme.Material3 a plain <Button> is inflated as MaterialButton, and
      MaterialButton IGNORES android:background (it owns its own background so it can draw
      ripple, elevation and shape). A style that sets android:background therefore silently
      loses it and falls back to the default filled look tinted with colorPrimary. That is
      exactly what shipped: secondary buttons rendered saffron-on-saffron and their labels
      were invisible on the device even though the layouts set android:text correctly.

      So: tint via backgroundTint, icons via app:icon/iconTint (not android:drawableStart,
      which MaterialButton also re-lays-out differently), and shape via cornerRadius.
    -->

    <!-- Primary / hero action: the one dominant CTA on a screen. -->
    <style name="SetupButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="backgroundTint">@color/md_primary</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="iconTint">@color/md_on_primary</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Secondary action: quiet tonal button, deliberately demoted so it never competes
         with the hero action on the same screen. -->
    <style name="SetupButtonSecondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="backgroundTint">@color/md_surface_container_high</item>
        <item name="android:textColor">@color/kb_accent</item>
        <item name="iconTint">@color/kb_accent</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/md_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <!-- Destructive / stop action: coral outline, used sparingly. -->
    <style name="SetupButtonDestructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/md_error</item>
        <item name="iconTint">@color/md_error</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/md_error</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>

    <!--
      Plain-Button equivalents for surfaces that are NOT Activities.

      The Setup* styles above inherit Widget.Material3.Button.*, which only works where the
      inflation context carries a Material3 theme — i.e. inside an Activity. An
      InputMethodService and a WindowManager overlay do NOT: there a <Button> stays a plain
      android.widget.Button, which silently ignores app:backgroundTint, app:cornerRadius and
      app:icon. Using the Setup* styles there produced an unstyled grey rectangle with no
      icon (seen on-device on the keyboard's Mood button).

      So: keyboard_view.xml and overlay_panel.xml use these instead, styled purely with
      android: attributes that a plain Button honours.
    -->
    <style name="KbButtonPrimary">
        <item name="android:background">@drawable/mood_btn_bg</item>
        <item name="android:textColor">@color/md_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:drawableTint">@color/md_on_primary</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="KbButtonSecondary">
        <item name="android:background">@drawable/btn_secondary_bg</item>
        <item name="android:textColor">@color/kb_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:drawableTint">@color/kb_accent</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="SetupInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/tile_bg</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textColorHint">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
    </style>

    <!-- Standard card: quiet neutral container, 12dp radius. Used for ordinary grouped
         controls - never the loudest thing on the screen. -->
    <style name="SetupCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Hero card: the single dominant surface on a screen (e.g. "enable the keyboard").
         Bigger radius, a saffron outline, more breathing room - deliberately different from
         every other card so the eye lands here first. -->
    <style name="SetupCardHero" parent="SetupCard">
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/card_hero_bg</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="SetupCardHeaderRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>
    <style name="SetupCardIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">10dp</item>
    </style>
    <style name="SetupCardTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/kb_text</item>
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
    </style>
    <style name="SetupCardBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <!-- Small-caps section label used instead of another card box: groups related controls
         with typography and a divider rather than another identical rounded rectangle. -->
    <style name="SetupSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">@color/kb_text_muted</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SetupDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/md_outline_variant</item>
    </style>
</resources>
