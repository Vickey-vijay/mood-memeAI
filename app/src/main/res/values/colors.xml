<resources>
    <!-- Warm design system, light (default/day) variant. Saffron-and-ink brand, paper/cream
         surfaces - no violet anywhere. See values-night/colors.xml for the dark variant that
         the keyboard and overlay are seen in most of the time. Primary is a deeper burnt-amber
         here (not the brighter dark-mode saffron) so it still passes WCAG AA as text/icon
         color on a light surface, not just as a button fill. -->
    <color name="md_primary">#FFA15D0A</color>
    <color name="md_primary_pressed">#FF8A4E08</color>
    <color name="md_on_primary">#FFFFFBF3</color>
    <color name="md_primary_container">#FFFBE4C0</color>
    <color name="md_on_primary_container">#FF5A3400</color>

    <color name="md_secondary">#FF8A5A22</color>
    <color name="md_on_secondary">#FFFFFBF3</color>

    <color name="md_surface">#FFFBF7F0</color>
    <color name="md_on_surface">#FF241C12</color>
    <color name="md_surface_variant">#FFF0E6D6</color>
    <color name="md_on_surface_variant">#FF6B5D4C</color>
    <color name="md_surface_container">#FFF4EEE3</color>
    <color name="md_surface_container_high">#FFECE1CE</color>

    <color name="md_outline">#FFA6957C</color>
    <color name="md_outline_variant">#FFDED0BA</color>

    <color name="md_error">#FFC22F35</color>
    <color name="md_on_error">#FFFFFBF3</color>

    <color name="md_success">#FF2F7526</color>

    <!-- Keyboard/overlay tokens - aliased to the tokens above so they resolve to the correct
         light or dark value automatically. Only kb_key_pressed differs enough between modes
         (warm-cream highlight vs warm-ember glow) that it needs its own literal per file. -->
    <color name="kb_background">@color/md_surface</color>
    <color name="kb_key">@color/md_surface_variant</color>
    <color name="kb_key_special">@color/md_surface_container_high</color>
    <color name="kb_key_pressed">#FFF0CE93</color>
    <color name="kb_text">@color/md_on_surface</color>
    <color name="kb_accent">@color/md_primary</color>
    <color name="kb_toolbar">@color/md_surface_container</color>
    <color name="kb_text_muted">@color/md_on_surface_variant</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>
</resources>
